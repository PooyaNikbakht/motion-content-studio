RECOVERY_KEY=generate-with-npm-run-gen-recovery
SESSION_SECRET=generate-with-npm-run-gen-recovery

# Local-only "Dev sign in" button on /login (also needs a localhost or 127.0.0.1 host). Off by default. NEVER set this as a Worker secret or var in production.
# DEV_LOGIN=1

# Optional "Continue with Google" on /login. The button and /auth/google exist only when all three are set. ALLOWED_EMAIL may be comma-separated.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# ALLOWED_EMAIL=you@example.com
