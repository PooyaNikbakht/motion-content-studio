{
  "name": "motion-content-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Turn a pasted AI-director conversation into ElevenLabs audio files, a visual storyboard and a viral kit. Client-side app with a small Cloudflare Worker for login.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev --infer-origin-from-routes=false",
    "test": "node --test tests/*.test.js tests/*.test.mjs",
    "gen:recovery": "node scripts/gen-recovery.mjs",
    "seed:prompt": "node scripts/seed-director-prompt.mjs",
    "sync:sample": "cp samples/sample-conversation.txt public/demo/sample-conversation.txt",
    "db:migrate:local": "wrangler d1 migrations apply motion-books --local",
    "db:migrate:remote": "wrangler d1 migrations apply motion-books --remote",
    "deploy": "wrangler deploy",
    "pree2e": "npm run db:migrate:local && node scripts/e2e-reset-auth.mjs",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "fake-indexeddb": "^6.2.8",
    "jszip": "^3.10.2",
    "wrangler": "^4.164.0"
  }
}
